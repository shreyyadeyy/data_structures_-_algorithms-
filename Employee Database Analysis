
# Node class
class Node:
    def __init__(self, data):
        self.data = data
        self.left = None
        self.right = None

# Insert employee ID into BST
def insert(root, data):
    if root is None:
        return Node(data)

    if data < root.data:
        root.left = insert(root.left, data)
    elif data > root.data:
        root.right = insert(root.right, data)

    return root

# Level Order Traversal
def level_order(root):
    if root is None:
        print("Tree is empty")
        return

    queue = [root]

    while queue:
        size = len(queue)

        for i in range(size):
            node = queue.pop(0)
            print(node.data, end=" ")

            if node.left:
                queue.append(node.left)

            if node.right:
                queue.append(node.right)

        print()

# Find height of BST
def height(root):
    if root is None:
        return 0

    return 1 + max(height(root.left), height(root.right))

# Display leaf nodes
def leaf_nodes(root):
    if root is None:
        return

    if root.left is None and root.right is None:
        print(root.data, end=" ")
        return

    leaf_nodes(root.left)
    leaf_nodes(root.right)

# Main program
root = None

n = int(input("Enter number of employees: "))

for i in range(n):
    emp_id = int(input("Enter employee ID: "))
    root = insert(root, emp_id)

# Display original BST
print("\nOriginal BST (Level Wise):")
level_order(root)

# Create new BST using employee IDs
new_root = None
values = [50, 30, 70, 20, 40, 60, 80]

for value in values:
    new_root = insert(new_root, value)

print("\nNew BST (Level Wise):")
level_order(new_root)

# Display height
print("\nHeight of Original BST:", height(root))

# Display leaf nodes
print("Leaf Nodes (Employees with no subordinates):")
leaf_nodes(root)
print()
