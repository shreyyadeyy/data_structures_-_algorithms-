if __name__ == "__main__":
    match_results = [
        (2450, "ShadowViper"),
        (3890, "BlazeKnight"),
        (1720, "PixelNinja"),
        (4150, "ApexHunter"),
        (3100, "CyberWolf"),
        (2890, "NovaStrike"),
    ]

    top_down = sort_leaderboard_descending(match_results.copy())
    bottom_up = sort_scores_ascending(match_results.copy())

    print("=== Official Leaderboard (Min-Heap -> Descending) ===")
    for rank, (score, player) in enumerate(top_down, start=1):
        print(f"Rank #{rank}: {player:<14} | {score} pts")

    print("\n=== Ascending Score Order (Max-Heap -> Ascending) ===")
    for score, player in bottom_up:
        print(f"{score} pts - {player}")
