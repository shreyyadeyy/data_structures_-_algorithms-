
# Node class
class Node:
    def __init__(self, data):
        self.data = data
        self.left = None
        self.right = None

# Insert into BST
def insert(root, data):
    if root is None:
        return Node(data)

    if data < root.data:
        root.left = insert(root.left, data)
    else:
        root.right = insert(root.right, data)

    return root

# Print tree level-wise
def level_order(root):
    if root is None:
        print("Tree is empty")
        return

    queue = [root]

    while queue:
        level_size = len(queue)

        for i in range(level_size):
            node = queue.pop(0)
            print(node.data, end=" ")

            if node.left:
                queue.append(node.left)

            if node.right:
                queue.append(node.right)

        print()

# Find height of BST
def height(root):
    if root is None:
        return 0

    return 1 + max(height(root.left), height(root.right))

# Print leaf nodes
def leaf_nodes(root):
    if root is None:
        return

    if root.left is None and root.right is None:
        print(root.data, end=" ")
        return

    leaf_nodes(root.left)
    leaf_nodes(root.right)

# Create BST
root = None

n = int(input("Enter number of nodes: "))

for i in range(n):
    value = int(input("Enter value: "))
    root = insert(root, value)

# Print original BST
print("\nOriginal BST (Level Wise):")
level_order(root)

# Create a new BST using the same values
new_root = None

values = [50, 30, 70, 20, 40, 60, 80]

for value in values:
    new_root = insert(new_root, value)

# Print new BST
print("\nNew BST (Level Wise):")
level_order(new_root)

# Find height
print("\nHeight of Original BST:", height(root))

# Print leaf nodes
print("Leaf Nodes:")
leaf_nodes(root)
print()
