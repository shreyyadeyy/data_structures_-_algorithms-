if __name__ == "__main__":
    grid = PowerGridNetwork()

    # Candidate cable routes with installation costs (in ₹ Lakhs)
    candidate_routes = [
        ("Substation-North", "Substation-Central", 12),
        ("Substation-North", "Substation-East", 18),
        ("Substation-Central", "Substation-East", 10),
        ("Substation-Central", "Substation-West", 15),
        ("Substation-Central", "Substation-South", 22),
        ("Substation-East", "Substation-South", 14),
        ("Substation-West", "Substation-South", 11),
        ("Substation-West", "Substation-Industrial", 9),
        ("Substation-South", "Substation-Industrial", 16),
    ]

    for s1, s2, cost in candidate_routes:
        grid.add_possible_route(s1, s2, cost)

    print("Adjacency List (Candidate Routes & Cost in ₹ Lakhs):")
    grid.display_network()

    mst_cables, min_cost = grid.optimize_wiring_kruskal()
    print("\nOptimal Cabling Plan (MST):")
    for u, v, cost in mst_cables:
        print(f"{u} <---> {v} : ₹{cost} Lakhs")
    print(f"Minimum Total Wiring Cost: ₹{min_cost} Lakhs")
